---
import type { IServiceItem, IServiceCategory } from "../utils/types";
import "./ServicePageCard.css";
import ServiceHero from "./ServiceHero.astro";
import ServiceTrust from "./ServiceTrust.astro";
import ServiceDescription from "./ServiceDescription.astro";
import ServiceBenefits from "./ServiceBenefits.astro";
import ServiceReviews from "./ServiceReviews.astro";
import ServiceSteps from "./ServiceSteps.astro";
import ServiceFAQ from "./ServiceFAQ.astro";
import ServiceFinal from "./ServiceFinal.astro";

interface Props {
  item: IServiceItem;
  category: IServiceCategory;
}

const { item, category } = Astro.props;

const price = item.price ? item.price.toLocaleString("ru-RU") : null;

const trustItems = [
  { label: "Бесплатная диагностика", text: "При согласии на ремонт диагностика не оплачивается", icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>' },
  { label: "Гарантия на работы", text: "Даём гарантию на все выполненные работы и запчасти", icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"></path></svg>' },
  { label: "Выезд мастера", text: "Приедем к вам домой или в офис по Саратову и Энгельсу", icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>' },
  { label: "Быстрые сроки", text: "Большинство поломок устраняем за один визит", icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>' },
  { label: "Скидка для пенсионеров", text: "При предъявлении пенсионного удостоверения предоставляем скидку на ремонт", icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>' },
];

const steps = [
  { num: "01", title: "Оставьте заявку", text: "Заполните форму или позвоните — мы уточним детали неисправности" },
  { num: "02", title: "Диагностика", text: "Мастер приезжает в удобное время и бесплатно определяет причину поломки" },
  { num: "03", title: "Ремонт", text: "Чиним технику на месте или забираем в сервисный центр с вашего согласия" },
  { num: "04", title: "Гарантия", text: "Вы получаете технику назад с гарантией на работы и запчасти" },
];
---

<main id="service-page" class="section top service-page">
  <div class="padding-global">
    <div class="container-medium">
      <ServiceHero item={item} category={category} price={price} />

      <ServiceTrust items={trustItems} />

      <ServiceDescription text={item.text} />

      <div class="service-combined">
        <ServiceBenefits />
        <ServiceReviews />
      </div>

      <ServiceSteps steps={steps} />

      <ServiceFAQ price={price} />

      <ServiceFinal />
    </div>
  </div>

  <img loading="lazy" src="/image/services/default_header.jpg" alt="схемы" class="tumbnail banner"/>
</main>